# DevOps Copilot — Environment Variables
# Copy to .env and fill in values. Leave empty to run in MOCK_MODE.

# App
APP_ENV=development
APP_NAME=DevOps Copilot
DEBUG=true
MOCK_MODE=true
AUTO_SEED_KNOWLEDGE=true
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Database (Neon free tier Postgres — use local SQLite if empty)
# DATABASE_URL=postgresql+asyncpg://user:pass@ep-xxx.neon.tech/neondb?sslmode=require
DATABASE_URL=sqlite+aiosqlite:///./data/devops_copilot.db

# Groq (free Llama inference — get key at https://console.groq.com)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Ollama fallback (local, no key needed). Set PREFER_OLLAMA=true + MOCK_MODE=false to use it.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2
PREFER_OLLAMA=false

# ChromaDB
CHROMA_PERSIST_DIR=./data/chroma
CHROMA_COLLECTION=failure_knowledge

# GitHub App / webhook
GITHUB_WEBHOOK_SECRET=
GITHUB_TOKEN=
GITHUB_REPO_OWNER=
GITHUB_REPO_NAME=

# Slack (optional alerts)
SLACK_BOT_TOKEN=
SLACK_CHANNEL_ID=

# Embeddings (local sentence-transformers — no API cost)
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
